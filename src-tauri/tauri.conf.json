{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneDrop PrintForge",
  "version": "0.1.6",
  "identifier": "fr.onedrop3d.printforge",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "OneDrop PrintForge", "width": 1000, "height": 720, "minWidth": 720, "minHeight": 540 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "publisher": "OneDrop3D",
    "category": "Utility",
    "copyright": "OneDrop3D",
    "shortDescription": "Firmware, fichiers et musique pour la Prusa CORE One",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["French"] } }
  }
}
