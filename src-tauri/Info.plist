<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Ajouté par Tauri à l'Info.plist de l'application. Depuis macOS 15, joindre l'imprimante (Bonjour, PrusaLink)
       demande l'accès au réseau local : ce texte s'affiche dans la demande. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>OneDrop PrintForge cherche votre imprimante Prusa sur le réseau local et lui envoie fichiers et firmwares.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_prusalink._tcp</string>
  </array>
</dict>
</plist>
